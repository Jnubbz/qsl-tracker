# Copy to .env next to docker-compose.yml and replace every placeholder.
# These are not real credentials. The Flask app reads the variables
# below (boto3 reads the AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY pair).
# TUNNEL_TOKEN is only for the cloudflared service.

# Flask session signing key. Generate with:
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-with-a-long-random-hex-string

# Shared password for /admin/login.
ADMIN_PASSWORD=replace-with-an-admin-password

# Secure cookies by default (1 / unset). Use 0 only for a temporary
# plain-HTTP test on the LAN, then remove this line.
SESSION_COOKIE_SECURE=1

# QRZ.com -> Logbook -> Settings -> API.
QRZ_LOGBOOK_API_KEY=replace-with-the-qrz-logbook-api-key

# SQLite file inside the container. The compose file mounts the
# Unraid data directory at /data.
QSL_DB_PATH=/data/qsl_tracker.db

# Resend notification for /request-qsl. Both must be set or mail is skipped.
RESEND_API_KEY=replace-with-the-resend-api-key
NOTIFY_EMAIL=you@example.com

# QSL Photo Map bucket. AWS_REGION wins over AWS_DEFAULT_REGION.
# Put the bucket's real region here (the Render blueprint uses us-east-2).
S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

# Cloudflare tunnel token. Compose passes it to cloudflared. This file
# is also the app's env_file, so the app process sees it and ignores it.
TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token
