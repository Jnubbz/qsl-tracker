# Copy this to .env (same folder as docker-compose.yml) and fill in real
# values. .env is gitignored -- never commit it, it holds real secrets.

# Flask session signing key. MUST be fixed (not left blank/regenerated
# on each start) or sessions/logins will break intermittently across
# gunicorn worker restarts. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Resend API key + notification address for the "Request a QSL Card"
# email (see README's "Email notifications" section). Optional -- if
# left blank the form still works, it just won't send an email.
RESEND_API_KEY=
NOTIFY_EMAIL=

# QSL Photo Map -- S3 bucket for photos (bucket name/region aren't
# secret, but keeping everything in one file here for convenience).
S3_BUCKET=kn0ble-qsl-381999184691-us-east-2-an
AWS_REGION=us-east-2
# IAM credentials scoped to just this bucket's photocards/* prefix --
# see the "QSL Photo Map" section in README.md for the exact policy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Whatever password gates /admin/login (the QSL Photo Map's upload
# tools). Pick something not used anywhere else.
ADMIN_PASSWORD=
